--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -82,6 +82,12 @@
 LPATH := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin
 MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
 
+# Kleaf resolves drivers/kernelsu inside common and does not expose KSU Git metadata.
+# Exact official v3.4.1 commit and full-history count are verified by integrate.sh.
+KSU_GIT_VERSION := 3333
+KSU_GIT_TAG := v3.4.1
+KSU_GIT_VERSION_VALID := 1
+
 # Check if this is a git repository
 # Try to detect Git repo intelligently
 GIT_ROOT := $(shell cd $(MDIR) && $(LPATH) git rev-parse --show-toplevel 2>/dev/null)
